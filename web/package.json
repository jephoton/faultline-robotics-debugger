{
  "name": "faultline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faultline control panel front end. Builds into src/robot_debug/viewer/app/.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.3",
    "cross-env": "7.0.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
